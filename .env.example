# Optional local AI only. The manual CultureLoop journey requires no credentials.
# Copy this file to .env.local at the repository root, then supply your own key.
# Never prefix a private key with VITE_ or commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Public deployment stays disabled until hosting abuse/spending protection is configured.
CULTURELOOP_AI_PUBLIC_ENABLED=false
